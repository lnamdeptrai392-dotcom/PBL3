<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="PBL3a.UI.Student.StudentFee"
             Background="White" Height="500" Width="750">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="39"/>
        </Grid.ColumnDefinitions>

        <TextBlock
                   Grid.Column="1"
                   Text="HỌC PHÍ"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="MidnightBlue"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" Height="42" Width="132"/>

        <DataGrid x:Name="dataGridView1"
                  Grid.Row="1"
                  Grid.Column="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="White"
                  BorderBrush="#DDDDDD"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã lớp học" Binding="{Binding ClassID}" Width="100"/>
                <DataGridTextColumn Header="Năm học" Binding="{Binding TuitionYear}" Width="*"/>
                <DataGridTextColumn Header="Tháng học" Binding="{Binding TuitionMonth}" Width="80"/>
                <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, StringFormat={}{0:N0} VNĐ}" Width="120"/>
                <DataGridTextColumn Header="Ngày đóng" Binding="{Binding NgayDong}" Width="120"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>