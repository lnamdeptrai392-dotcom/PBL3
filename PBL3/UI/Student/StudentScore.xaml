<UserControl x:Class="PBL3a.UI.Student.StudentScore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="750" Height="500">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Text="KẾT QUẢ HỌC TẬP"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <ComboBox x:Name="cboSemester"
                      Width="158"
                      Height="30"
                      SelectionChanged="cboSemester_SelectedIndexChanged"/>

            <Button x:Name="btnShowData"
                    Content="Dữ liệu"
                    Width="94"
                    Height="30"
                    Margin="28,0,0,0"
                    Click="btnShowData_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgvScore"
                  Grid.Row="2"
                  Grid.Column="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="White">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Mã lớp học" Binding="{Binding ClassID}" Width="150"/>
                <DataGridTextColumn Header="Tên lớp học" Binding="{Binding ClassName}" Width="200"/>
                <DataGridTextColumn Header="Điểm học tập" Binding="{Binding DiemHocTap}" Width="150"/>
                <DataGridTextColumn Header="Nhận xét" Binding="{Binding NhanXet}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        
    </Grid>
</UserControl>