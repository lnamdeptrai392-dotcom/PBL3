<Window x:Class="PBL3a.UI.AdminTC.QuanLyChungTC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuanLyChungTC"
        Width="1000" Height="700"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <!-- Style nút menu thường -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBCDE0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút ACTIVE (đang chọn) -->
        <Style x:Key="MenuButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Style nút Đăng xuất -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF9A9A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7B1111"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#2C4E62">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Avatar/User -->
                    <RowDefinition Height="*"/>
                    <!-- Menu -->
                    <RowDefinition Height="Auto"/>
                    <!-- Logout -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Background="#2C4E62" Height="70">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎓" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="EduCore" FontSize="22" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Avatar + Tên người dùng -->
                <Border Grid.Row="1" Background="#0F2840" Margin="12,10" CornerRadius="10" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <!-- Avatar tròn -->
                        <Border Width="42" Height="42" CornerRadius="21" Background="#1E88E5" Margin="0,0,10,0">
                            <TextBlock x:Name="tbAvatarChar" Text="A" FontSize="18" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="tbUserName" Text="Admin Tài Chính"
                                       Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Quản lý tài chính" Foreground="#7FA8CC" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menu Items -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,5,0,5">

                        <!-- Tổng quan -->
                        <Button x:Name="btnDashboard" Content="  🏠  Tổng quan"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnDashborad_Click"/>

                        <!-- Separator label -->
                        <TextBlock Text="NGHIỆP VỤ" Foreground="#4A7FA5" FontSize="10"
                                   FontWeight="Bold" Margin="22,12,0,4" />

                        <Button x:Name="btnThuHP" Content="  💰  Thu học phí"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnThuHP_Click"/>
                        <Button x:Name="btnLuong" Content="  💵  Chi trả lương"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnLuong_Click"/>
                        <Button x:Name="btnKhac" Content="  📋  Khoản chi khác"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnKhac_Click"/>

                        <!-- Separator label -->
                        <TextBlock Text="BÁO CÁO" Foreground="#4A7FA5" FontSize="10"
                                   FontWeight="Bold" Margin="22,12,0,4"/>

                        <!-- Button Theo doi hoc phi -->
                        <Button x:Name="btnTheoDoiHP" Content="  🧾  Theo dõi học phí"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnTheoDoiHP_Click"/>


                        <Button x:Name="btnThongKe" Content="  📊  Thống kê tài chính"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnThongKe_Click"/>
                        <Button x:Name="btnProfit" Content="  📈  Báo cáo lợi nhuận"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="btnProfit_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Đăng xuất -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#1E3A5C" Margin="0,0,0,10">
                    <Button x:Name="btnExit" Content="  🚪  Đăng xuất"
                            Style="{StaticResource LogoutButtonStyle}"
                            Click="btnExit_Click"/>
                </Border>
            </Grid>
        </Border>

        <!-- Nội dung chính -->
        <ContentControl x:Name="paDesktop" Grid.Column="1" Background="#F0F2F5"/>
    </Grid>
</Window>