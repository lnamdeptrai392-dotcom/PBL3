<UserControl x:Class="PBL3a.UI.AdminTC.HocPhi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
mc:Ignorable="d"
Background="#F0F2F5" d:DesignWidth="800"  d:DesignHeight="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh bộ lọc phía trên (Style giống EduCore) -->
        <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="20,10" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Môn học:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbbCourse" Width="130" Height="32" Margin="0,0,25,0" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Toán" Tag="MAT"/>
                    <ComboBoxItem Content="Văn" Tag="LIT"/>
                    <ComboBoxItem Content="Anh" Tag="ENG"/>
                    <ComboBoxItem Content="Lý" Tag="PHY"/>
                    <ComboBoxItem Content="Hóa" Tag="CHE"/>
                    <ComboBoxItem Content="Sinh" Tag="BIO"/>
                </ComboBox>

                <TextBlock Text="Khối:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbbGrade" Width="100" Height="32" Margin="0,0,25,0" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>

                <TextBlock Text="Lớp:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbbML" Width="150" Height="32" Margin="0,0,20,0"/>

                <Button Content="Xem" Width="80" Height="32" Background="#1E88E5" Foreground="White" BorderThickness="0" Click="Button_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Vùng nội dung chính -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề danh sách -->
                <TextBlock Grid.Row="0" Text="Danh sách học phí" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="5,0,0,15"/>

                <!-- DataGrid -->
                <DataGrid x:Name="dataGridView1"
                          Grid.Row="1"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="1"
                          BorderBrush="#E0E0E0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          RowHeight="35">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#BBDEFB"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HS" Binding="{Binding AccountID}" Width="100"/>
                        <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*"/>
                        <DataGridTextColumn Header="Ngày đóng" Binding="{Binding NgayDong}" Width="80"/>
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, StringFormat={}{0:N0} VNĐ}" Width="150"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Nút chức năng phía dưới -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="btSetHP"
                            Content="Thiết lập học phí"
                            Width="160"
                            Height="38"
                            Background="#1E88E5"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="btSetHP_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>