<UserControl x:Class="PBL3a.UI.AdminTC.Lai"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Height="500" Width="750">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>


        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Tháng:"
                   FontSize="16"
                   VerticalAlignment="Center"/>

        <ComboBox x:Name="cbbThang" SelectionChanged="Filter_Changed"
  Grid.Row="0" Grid.Column="1" BorderBrush="White" Foreground="Black" Margin="0,12,0,10" >
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
            <ComboBoxItem Content="7"/>
            <ComboBoxItem Content="8"/>
            <ComboBoxItem Content="9"/>
            <ComboBoxItem Content="10"/>
            <ComboBoxItem Content="11"/>
            <ComboBoxItem Content="12"/>
        </ComboBox>


        <TextBlock Grid.Column="2"
                   Text="Năm:"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="60,0,10,0"/>

        <ComboBox x:Name="cbbNam" Grid.Column="3"
                  Height="36"
                  VerticalAlignment="Center" Margin="0,0,70,0">
            <ComboBoxItem Content="2025"/>
            <ComboBoxItem Content="2026"/>
        </ComboBox>
       
        <DataGrid x:Name="dataGridView1"
                  Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="All"
                  Background="White"
                  Margin="0,15,56,15" Width="660">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Danh mục" Binding="{Binding DanhMuc}" Width="200"/>
                <DataGridTextColumn Header="Tổng số tiền" Binding="{Binding SoTien, StringFormat={}{0:N0} VNĐ}" Width="200"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding Loai}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Highlight dòng Lợi nhuận -->
                        <DataTrigger Binding="{Binding Loai}" Value="KetQua">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                        </DataTrigger>
                        <!-- Dòng Chi có màu đỏ nhạt để dễ phân biệt -->
                        <DataTrigger Binding="{Binding Loai}" Value="Chi">
                            <Setter Property="Foreground" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Lợi nhuận:"
                   FontSize="16"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="txtLoiNhuan"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="34"
                 IsReadOnly="True"
                 VerticalAlignment="Center" Margin="0,0,68,0"/>
    </Grid>
</UserControl>