<UserControl x:Class="PBL3a.UI.AdminTC.Lai"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Background="#F0F2F5" d:DesignWidth="800"  d:DesignHeight="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh bộ lọc (Style EduCore) -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tháng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#555"/>
                <ComboBox x:Name="cbbThang" Width="100" Height="32" Margin="0,0,30,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>

                <TextBlock Text="Năm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#555"/>
                <ComboBox x:Name="cbbNam" Width="120" Height="32" Margin="0,0,30,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="2025"/>
                    <ComboBoxItem Content="2026"/>
                </ComboBox>

                <Button x:Name="btnExport" Content="Xuất báo cáo" Width="120" Height="32" 
                        Background="#1E88E5" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Vùng nội dung chính (Card báo cáo) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Summary Footer -->
                </Grid.RowDefinitions>

                <!-- Tiêu đề báo cáo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,15">
                    <Rectangle Width="4" Height="20" Fill="#1E88E5" Margin="0,0,10,0"/>
                    <TextBlock Text="BÁO CÁO KẾT QUẢ TÀI CHÍNH" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="dataGridView1"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          BorderBrush="#E0E0E0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          RowHeight="40">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#BBDEFB"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Danh mục thu chi" Binding="{Binding DanhMuc}" Width="*"/>
                        <DataGridTextColumn Header="Tổng số tiền" Binding="{Binding SoTien, StringFormat={}{0:N0} VNĐ}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Loại" Binding="{Binding Loai}" Width="150"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Highlight dòng Lợi nhuận / Kết quả -->
                                <DataTrigger Binding="{Binding Loai}" Value="KetQua">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <!-- Dòng Chi có màu đỏ nhạt -->
                                <DataTrigger Binding="{Binding Loai}" Value="Chi">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Footer Summary: Lợi nhuận -->
                <Border Grid.Row="2" Background="#F1F8E9" CornerRadius="5" Padding="15" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="LỢI NHUẬN THỰC TẾ:" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLoiNhuan"
                                 Width="220" Height="38" Margin="20,0,0,0"
                                 IsReadOnly="True" Background="White" BorderBrush="#A5D6A7"
                                 FontSize="18" FontWeight="Bold" Foreground="#2E7D32"
                                 VerticalContentAlignment="Center" Padding="10,0" TextAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>