<Window x:Class="PBL3a.UI.AdminTC.ThietLapHP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết Lập Học Phí"
        Width="1000"
        Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F0F2F5" CornerRadius="15" BorderThickness="1" BorderBrush="#D0D0D0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Info Section -->
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Rectangle Width="5" Height="30" Fill="#1E88E5" Margin="0,0,10,0"/>
                <TextBlock Text="THIẾT LẬP HỌC PHÍ" FontSize="22" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Section: Thông tin lớp & Học phí -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1 -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,15">
                        <TextBlock Text="Mã Lớp" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="txtMaLop" IsReadOnly="True" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,20,15">
                        <TextBlock Text="Tên Lớp" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="tbTL" IsReadOnly="True" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,0,15">
                        <TextBlock Text="Sĩ số" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="txtSS" IsReadOnly="True" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Số tiền / Học sinh (VNĐ)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#1E88E5"/>
                        <TextBox x:Name="txtTienTrenNg" Height="35" VerticalContentAlignment="Center" BorderBrush="#1E88E5" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="Tổng tiền dự kiến" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="txtTongT" IsReadOnly="True" Height="35" VerticalContentAlignment="Center" Background="#F1F8E9" Foreground="#2E7D32" FontWeight="Bold"/>
                    </StackPanel>

                    <Button x:Name="butTT" Grid.Row="1" Grid.Column="2" Content="Tính tổng tiền" Height="35" VerticalAlignment="Bottom" 
                            Background="#81C784" Foreground="White" BorderThickness="0" Click="butTT_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Danh sách học sinh trong lớp" FontWeight="SemiBold" Margin="5,0,0,10" Foreground="#1565C0"/>

                    <DataGrid x:Name="dgHocSinhLop" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                              Background="White" BorderThickness="1" BorderBrush="#E0E0E0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0" RowHeight="35">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#BBDEFB"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Mã HS" Binding="{Binding AccountID}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TrangThai}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged}" 
                                                  SelectedValuePath="Content" IsDropDownOpen="True">
                                            <ComboBoxItem Content="Chưa đóng"/>
                                            <ComboBoxItem Content="Đã đóng"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 4. Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="btLuu" Content="Lưu dữ liệu" Width="130" Height="40" Background="#1E88E5" Foreground="White" 
                        BorderThickness="0" Margin="0,0,10,0" Click="btLuu_Click" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="button1" Content="Đóng" Width="100" Height="40" Background="#EF5350" Foreground="White" 
                        BorderThickness="0" Click="button1_Click" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>