<UserControl x:Class="PBL3a.UI.AdminTC.KhoanChi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
mc:Ignorable="d"
Background="#F0F2F5" d:DesignWidth="800"  d:DesignHeight="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh bộ lọc (Style giống EduCore) -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tháng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#555"/>
                <ComboBox x:Name="cbbThang" Width="100" Height="32" Margin="0,0,30,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>

                <TextBlock Text="Năm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#555"/>
                <ComboBox x:Name="cbbNam" Width="120" Height="32" Margin="0,0,30,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="2025"/>
                    <ComboBoxItem Content="2026"/>
                </ComboBox>

                <Button x:Name="btnSearch" Content="Xem báo cáo" Width="120" Height="32" 
                        Background="#1E88E5" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Vùng nội dung chính (Card trắng) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer Info & Buttons -->
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,15">
                    <Rectangle Width="4" Height="20" Fill="#1E88E5" Margin="0,0,10,0"/>
                    <TextBlock Text="Danh sách các khoản chi" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="dataGridView1"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="True"
                          SelectionUnit="FullRow"
                          Background="White"
                          BorderBrush="#E0E0E0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          RowHeight="38">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#BBDEFB"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Chi" Binding="{Binding ChiID}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Loại chi" Binding="{Binding LoaiChi}" Width="150"/>
                        <DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDung}" Width="*"/>
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, StringFormat={}{0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ngày chi" Binding="{Binding NgayChi}" Width="120"/>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer: Tổng chi & Nút bấm -->
                <Grid Grid.Row="2" Margin="0,15,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Tổng chi tháng:" FontSize="15" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
                        <TextBox x:Name="tbKT" Width="180" Height="35" Margin="15,0,0,0"
                                 IsReadOnly="True" Background="#FFF5F5" BorderBrush="#FFCDD2" 
                                 FontSize="16" FontWeight="Bold" Foreground="#D32F2F"
                                 VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAdd" Content="Thêm dữ liệu" Width="130" Height="40" 
                                Background="#81C784" Foreground="White" BorderThickness="0" 
                                Margin="0,0,10,0" Click="btnAdd_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="btnSave" Content="Lưu thay đổi" Width="130" Height="40" 
                                Background="#1E88E5" Foreground="White" BorderThickness="0" 
                                Click="btnSave_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>