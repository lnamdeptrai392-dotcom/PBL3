<UserControl x:Class="PBL3a.UI.AdminTC.LuongGV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5"
             Height="650" Width="1050">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh bộ lọc phía trên -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,25,0">
                    <TextBlock Text="Mã Giáo viên:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                    <ComboBox x:Name="cbbMGV" Width="150" Height="32" IsEditable="True"
                              SelectionChanged="cbbMGV_SelectionChanged" KeyUp="cbbMGV_KeyUp"/>
                </StackPanel>

                <StackPanel Margin="0,0,25,0">
                    <TextBlock Text="Tên Giáo viên:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                    <TextBox x:Name="tbTL" Width="200" Height="32" IsReadOnly="True" 
                             VerticalContentAlignment="Center" Background="#F9F9F9"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Thời gian (Tháng/Năm):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cbbThang" Width="80" Height="32" Margin="0,0,10,0">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                        </ComboBox>
                        <TextBox x:Name="txtNam" Width="80" Height="32" VerticalContentAlignment="Center" Text="2026"/>
                    </StackPanel>
                </StackPanel>
                
                <Button Content="Tìm kiếm" Width="100" Height="32" VerticalAlignment="Bottom" x:Name="btnSearch" Click="btnSearch_Click"
                        Background="#1E88E5" Foreground="White" BorderThickness="0" Margin="10,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Vùng nội dung chính (Bảng lương) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,15">
                    <Rectangle Width="4" Height="20" Fill="#1E88E5" Margin="0,0,10,0"/>
                    <TextBlock Text="Chi tiết bảng lương" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>

                <DataGrid x:Name="dataGridView1"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          BorderBrush="#E0E0E0"
                          RowHeight="38"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#BBDEFB"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Lương" Binding="{Binding LuongID}" Width="90"/>
                        <DataGridTextColumn Header="Tháng" Binding="{Binding SalaryMonth}" Width="70"/>
                        <DataGridTextColumn Header="Lớp" Binding="{Binding SoLopDay}" Width="60"/>
                        <DataGridTextColumn Header="Buổi" Binding="{Binding SoBuoiDay}" Width="60"/>
                        <DataGridTextColumn Header="Lương cơ bản" Binding="{Binding LuongCoBan, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="Thưởng" Binding="{Binding Thuong, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="Phạt" Binding="{Binding Phat, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongLuong, StringFormat={}{0:N0}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left"
                                            Background="{Binding TrangThai}">
                                        <TextBlock Text="{Binding TrangThai}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged}" 
                                              SelectedValuePath="Content" IsDropDownOpen="True">
                                        <ComboBoxItem Content="Chưa thanh toán"/>
                                        <ComboBoxItem Content="Đã thanh toán"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 3. Nút chức năng phía dưới -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,5">
                    <Button x:Name="btSetL"
                            Content="Tính toán lương"
                            Width="140" Height="40"
                            Background="#81C784" Foreground="White"
                            BorderThickness="0" Margin="0,0,12,0"
                            Click="btSetL_Click">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnSave"
                            Content="Lưu thay đổi"
                            Width="140" Height="40"
                            Background="#1E88E5" Foreground="White"
                            BorderThickness="0"
                            Click="btnSave_Click">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>