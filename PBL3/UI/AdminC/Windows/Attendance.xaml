<UserControl x:Class="PBL3.UI.AdminC.Windows.Attendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F4F8FB">

    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="Button" x:Key="BtnPrimary">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E3EEF7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E3EEF7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0E3F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FCFF"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Foreground" Value="#0D47A1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="White" 
                CornerRadius="14" 
                Padding="14" 
                BorderBrush="#D6E6F2" 
                BorderThickness="1" 
                Margin="0,0,10,0">

            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                    <TextBlock Text="Danh sách học sinh điểm danh" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#0D47A1" 
                               VerticalAlignment="Center"/>
                </Grid>

                <DataGrid x:Name="dgvAttendance" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HS" Binding="{Binding StudentID}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="180" IsReadOnly="True" ElementStyle="{StaticResource LeftAlignStyle}"/>

                        <DataGridTemplateColumn Header="Trạng Thái" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TrangThai}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                              SelectedValuePath="Content" IsDropDownOpen="True" Margin="2">
                                        <ComboBoxItem Content="Có mặt"/>
                                        <ComboBoxItem Content="Đi muộn"/>
                                        <ComboBoxItem Content="Vắng có phép"/>
                                        <ComboBoxItem Content="Vắng không phép"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*" IsReadOnly="False" ElementStyle="{StaticResource LeftAlignStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="White" 
                CornerRadius="14" 
                Padding="16" 
                BorderBrush="#D6E6F2" 
                BorderThickness="1" 
                Margin="2,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Thông Tin Lớp Học" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#0D47A1" 
                               Margin="0,0,0,15" 
                               HorizontalAlignment="Center"/>

                    <Label Content="Chọn lớp học"/>
                    <ComboBox x:Name="cbbClass" SelectionChanged="cbbClass_SelectionChanged"/>

                    <Label Content="Giáo viên dạy"/>
                    <TextBox x:Name="txtTeacher" IsReadOnly="True" Background="#F9FCFF"/>

                    <Label Content="Trạng thái lớp"/>
                    <TextBox x:Name="txtStatus" Text="Đang mở" IsReadOnly="True" FontWeight="Bold" Foreground="#2E7D32" Background="#E8F5E9" TextAlignment="Center"/>

                    <TextBlock Text="Thời Gian Điểm Danh" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#0D47A1" 
                               Margin="0,20,0,15" 
                               HorizontalAlignment="Center"/>

                    <Label Content="Ngày học"/>
                    <ComboBox x:Name="cbbDate" SelectionChanged="cbbDate_SelectionChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <Label Content="Giờ bắt đầu"/>
                            <TextBox x:Name="txtStartTime" IsReadOnly="True" TextAlignment="Center" Background="#F9FCFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Label Content="Giờ kết thúc"/>
                            <TextBox x:Name="txtEndTime" IsReadOnly="True" TextAlignment="Center" Background="#F9FCFF"/>
                        </StackPanel>
                    </Grid>

                    <Label Content="Thứ trong tuần"/>
                    <TextBox x:Name="txtDayOfWeek" IsReadOnly="True" TextAlignment="Center" Background="#F9FCFF"/>
                    <Button Content="Lưu Điểm Danh" Style="{StaticResource BtnPrimary}" Margin="0,25,0,0" Height="40" Background="#43A047" Click="btnLuu_Click"/>


                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>