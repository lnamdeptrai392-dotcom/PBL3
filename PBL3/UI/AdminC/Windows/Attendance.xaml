<UserControl x:Class="PBL3.UI.AdminC.Windows.Attendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Background="#F4F8FB">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <!-- Bảng điểm danh -->
            <ColumnDefinition Width="2*" />
            <!-- Thông tin lớp và thời gian -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        

        <!-- Phần DataGridView điểm danh -->
        <Border Grid.Column="0" BorderBrush="#FF263F60" Background="White" CornerRadius="8" Padding="10" Margin="0,82,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Danh sách học sinh trong lớp" FontWeight="SemiBold" Margin="5,10,0,10" Foreground="#1565C0"/>
                <DataGrid x:Name="dgvAttendance" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
          Background="White" BorderThickness="1" BorderBrush="#E0E0E0" GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#F0F0F0" RowHeight="35" Margin="0,10,0,56">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#BBDEFB"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HS" Binding="{Binding StudentID}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TrangThai}" VerticalAlignment="Center" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                              SelectedValuePath="Content" IsDropDownOpen="True">
                                        <ComboBoxItem Content="Có mặt"/>
                                        <ComboBoxItem Content="Đi muộn"/>
                                        <ComboBoxItem Content="Vắng có phép"/>
                                        <ComboBoxItem Content="Vắng không phép"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            
        </Border>

        <!-- Phần thông tin lớp học -->
        <StackPanel Grid.Column="1" Margin="20,77,0,0">
            <Border  Background="White" BorderThickness="2" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Thông tin lớp học" FontSize="16" FontWeight="Bold" Foreground="#FF263F60" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="Chọn lớp học:" Width="120" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbbClass" Width="200" SelectionChanged="cbbClass_SelectionChanged"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="Trạng thái:" Width="120" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatus" Text="Đang mở" Foreground="Green" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,15">
                        <TextBlock Text="Giáo viên dạy:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtTeacher" Width="200"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phần thời gian -->
            <Border  Background="White" BorderThickness="2" CornerRadius="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Thời gian" FontSize="16" FontWeight="Bold" Foreground="#FF263F60" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="Ngày:" Width="120" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbbDate" Width="200" SelectionChanged="cbbDate_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="Giờ bắt đầu:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtStartTime" Width="80"/>
                        <TextBlock Text=" - " VerticalAlignment="Center"/>
                        <TextBox x:Name="txtEndTime" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,15">
                        <TextBlock Text="Thứ:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDayOfWeek" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <TextBlock
            FontSize="20"
            FontWeight="Bold"
            IsHitTestVisible="False"
            Foreground="#FF263F60"
                           Margin="28,29,202,374"><Run Language="vi-vn" Text="Quản lý Điểm danh"/><LineBreak/><Run Language="vi-vn"/></TextBlock>
    </Grid>
</UserControl>
