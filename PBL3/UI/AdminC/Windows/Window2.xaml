<UserControl x:Class="PBL3a.UI.AdminC.Windows.Window2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#F5F7FA" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Text="Tạo lớp học"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="10"
                       Foreground="#2C3E50"/>

            <!-- FILTER -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0 10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <WrapPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Môn học"/>
                        <ComboBox x:Name="cbbMH" Width="150"
                                  SelectionChanged="cbbMH_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Khối"/>
                        <ComboBox x:Name="cbbKhoi" Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Số lượng"/>
                        <TextBox x:Name="txtSL" Width="120"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Ngày mở"/>
                        <DatePicker x:Name="dtpNgayMo" Width="150"/>
                    </StackPanel>

                </WrapPanel>
            </Border>

            <!-- TABLE -->
            <Grid Grid.Row="2" Margin="0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="10" Margin="0 0 10 0">
                    <DataGrid x:Name="dgvGV"
                              AutoGenerateColumns="True"
                              SelectionChanged="dgvGV_SelectionChanged"
                              RowHeight="35"/>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="10">
                    <DataGrid x:Name="dgvTTGV"
                              AutoGenerateColumns="True"
                              RowHeight="35"/>
                </Border>
            </Grid>

            <!-- BUTTON -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">

                <Button Content="Tạo lớp học"
                        Width="180"
                        Height="45"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="10"
                        Click="btnOK_Click"/>

                <Button Content="Lưu DB"
                        Width="180"
                        Height="45"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="10"
                        Click="btnDB_Click"/>
            </StackPanel>

            <!-- TEMP TABLE -->
            <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="10" Margin="0 10">
                <DataGrid x:Name="dgvLH"
                          AutoGenerateColumns="False"
                          RowHeight="35">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Lớp" Binding="{Binding [Mã Lớp]}"/>
                        <DataGridTextColumn Header="Tên Lớp" Binding="{Binding [Tên Lớp]}"/>
                        <DataGridTextColumn Header="Mã Khóa Học" Binding="{Binding [Mã Khóa Học]}"/>
                        <DataGridTextColumn Header="Mã GV" Binding="{Binding [Mã GV]}"/>

                        <!-- FIX FORMAT NGÀY -->
                        <DataGridTextColumn Header="Ngày Bắt Đầu"
                            Binding="{Binding [Ngày Bắt Đầu], StringFormat=dd/MM/yyyy}"/>

                        <DataGridTextColumn Header="Ngày Kết Thúc"
                            Binding="{Binding [Ngày Kết Thúc], StringFormat=dd/MM/yyyy}"/>

                        <DataGridTextColumn Header="Sức Chứa" Binding="{Binding [Sức Chứa]}"/>
                        <DataGridTextColumn Header="Khối" Binding="{Binding [Khối]}"/>
                    </DataGrid.Columns>

                </DataGrid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>