<UserControl x:Class="PBL3a.UI.AdminC.Windows.Window2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FB">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E3EEF7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E3EEF7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0E3F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Foreground" Value="#0D47A1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Tạo lớp học"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#0D47A1"
                       Margin="0 0 0 16"/>

            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14" BorderBrush="#D6E6F2" BorderThickness="1" Margin="0 0 0 16">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0 0 20 10" VerticalAlignment="Center">
                        <TextBlock Text="Môn học:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 8 0"/>
                        <ComboBox x:Name="cbbMH" Width="150" SelectionChanged="cbbMH_SelectionChanged" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 20 10" VerticalAlignment="Center">
                        <TextBlock Text="Khối:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 8 0"/>
                        <ComboBox x:Name="cbbKhoi" Width="120" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 20 10" VerticalAlignment="Center">
                        <TextBlock Text="Số lượng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 8 0"/>
                        <TextBox x:Name="txtSL" Width="100" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 20 10" VerticalAlignment="Center">
                        <TextBlock Text="Học phí:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 8 0"/>
                        <TextBox x:Name="txtHocPhi" Width="130" Text="0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" VerticalAlignment="Center">
                        <TextBlock Text="Ngày mở:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 8 0"/>
                        <DatePicker x:Name="dtpNgayMo" Width="140" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="14" BorderBrush="#D6E6F2" BorderThickness="1" Margin="0 0 12 0">
                    <StackPanel>
                        <TextBlock Text="Chọn Giáo Viên" FontWeight="Bold" Foreground="#0D47A1" Margin="0 0 0 8"/>
                        <DataGrid x:Name="dgvGV" Height="350" AutoGenerateColumns="True" SelectionChanged="dgvGV_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14" BorderBrush="#D6E6F2" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Thông Tin Chi Tiết Giáo Viên" FontWeight="Bold" Foreground="#0D47A1" Margin="0 0 0 8"/>
                        <DataGrid x:Name="dgvTTGV" Height="350" AutoGenerateColumns="True"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 16">
                <Border CornerRadius="10" ClipToBounds="True" Margin="10 0">
                    <Button Content="Tạo lớp học" Width="160" Background="#43A047" Click="btnOK_Click" Height="40"/>
                </Border>

                <Border CornerRadius="10" ClipToBounds="True" Margin="10 0">
                    <Button Content="Lưu Vào DataBase" Width="160" Background="#1E88E5" Click="btnDB_Click" Height="40"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Background="White" CornerRadius="14" Padding="14" BorderBrush="#D6E6F2" BorderThickness="1" Margin="0 0 0 10">
                <StackPanel>
                    <TextBlock Text="Danh Sách Lớp Học Chuẩn Bị Tạo" FontWeight="Bold" Foreground="#0D47A1" Margin="0 0 0 8"/>
                    <DataGrid x:Name="dgvLH" AutoGenerateColumns="False" MinHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Lớp" Binding="{Binding [Mã Lớp]}" Width="100"/>
                            <DataGridTextColumn Header="Tên Lớp" Binding="{Binding [Tên Lớp]}" Width="150"/>
                            <DataGridTextColumn Header="Khối" Binding="{Binding [Khối]}" Width="70"/>
                            <DataGridTextColumn Header="Mã Khóa Học" Binding="{Binding [Mã Khóa Học]}" Width="100"/>
                            <DataGridTextColumn Header="Mã GV" Binding="{Binding [Mã GV]}" Width="80"/>
                            <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding [Ngày Bắt Đầu], StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Ngày Kết Thúc" Binding="{Binding [Ngày Kết Thúc], StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Sức Chứa" Binding="{Binding [Sức Chứa]}" Width="80"/>
                            <DataGridTextColumn Header="Học Phí" Binding="{Binding [Học Phí], StringFormat={}{0:N0}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>