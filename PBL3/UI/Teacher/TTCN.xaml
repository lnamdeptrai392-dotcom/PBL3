<UserControl x:Class="PBL3a.UI.Teacher.TTCN"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
mc:Ignorable="d"
Background="#F0F2F5" d:DesignWidth="800"  d:DesignHeight="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="THÔNG TIN CÁ NHÂN" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#1565C0" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>

        <!-- Main Content Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <!-- Khoảng cách giữa 2 cột -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ và tên" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox x:Name="tbHVT" Height="35" Margin="0,0,0,15" Padding="5,7" BorderBrush="#DCDFE6"/>

                    <TextBlock Text="Giới tính" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <ComboBox x:Name="cbbGT" Height="35" Margin="0,0,0,15" BorderBrush="#DCDFE6">
                        <ComboBoxItem Content="Nam"/>
                        <ComboBoxItem Content="Nữ"/>
                    </ComboBox>

                    <TextBlock Text="Ngày sinh" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <DatePicker x:Name="dtNS" Height="35" Margin="0,0,0,15" BorderBrush="#DCDFE6"/>
                </StackPanel>

                <!-- Cột phải -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số điện thoại" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox x:Name="tbSDT" Height="35" Margin="0,0,0,15" Padding="5,7" BorderBrush="#DCDFE6"/>

                    <TextBlock Text="Email" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                    <TextBox x:Name="tbE" Height="35" Margin="0,0,0,15" Padding="5,7" BorderBrush="#DCDFE6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Chuyên môn" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                            <TextBox x:Name="tbMD" Height="35" IsReadOnly="True" Background="#F5F7FA" BorderBrush="#DCDFE6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Mã giảng viên" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                            <TextBox x:Name="tbMGV" Height="35" IsReadOnly="True" Background="#F5F7FA" BorderBrush="#DCDFE6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Button -->
        <Button x:Name="btnUpdate"
                Grid.Row="2"
                Content="Cập nhật thông tin"
                Width="180" Height="40"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Background="#5D9CB3" Foreground="White"
                FontWeight="SemiBold" Cursor="Hand"
                Click="btnUpdate_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>