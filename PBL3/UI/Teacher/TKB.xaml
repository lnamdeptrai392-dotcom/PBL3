<UserControl x:Class="PBL3a.UI.Teacher.TKB"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
mc:Ignorable="d"
Background="#F0F2F5" d:DesignWidth="800"  d:DesignHeight="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Section -->
            <RowDefinition Height="*"/>
            <!-- Schedule Table -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="LỊCH DẠY CHI TIẾT" 
                   FontSize="26" FontWeight="Bold" Foreground="#2C3E50"
                   Margin="10,0,0,20"/>

        <!-- FILTER SECTION -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Mã lớp học" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <ComboBox x:Name="comboBox1" Width="200" Height="35"
                              SelectionChanged="comboBox1_SelectedIndexChanged"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Tên lớp học" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="textBox1" Width="300" Height="35"
                             IsReadOnly="True" Background="#F5F7FA" 
                             Padding="10,7" BorderBrush="#DCDFE6"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- SCHEDULE TABLE CARD -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <DataGrid x:Name="dataGridView1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      RowHeight="40">
                <DataGrid.Columns>
                   
                    <DataGridTextColumn Header="Thứ" Binding="{Binding Thu}" Width="100"/>
                    <DataGridTextColumn Header="Ca dạy" Binding="{Binding Ca}" Width="120"/>
                    
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding ThoiGian}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="Foreground" Value="#34495E"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#DCDFE6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>