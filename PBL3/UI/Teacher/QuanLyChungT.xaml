<Window x:Class="PBL3a.UI.Teacher.QuanLyChungT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuanLyChungT"
        Width="1000"
        Height="500"
        
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0"
                    Grid.Row="0"
                    Background="#FF263F60">

            <Border Background="#263f60" Height="80">
                <TextBlock Text="EduCore"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
            </Border>

            <Button x:Name="btnInfo"
                    Content="    Thông tin cá nhân"
                    Foreground="White" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0" Height="44"
                    Margin="0,5,0,0"
                    Click="btnInfo_Click" Background="#FF263F60" HorizontalAlignment="Left" Width="220"/>

            <Button x:Name="btnSchedule"
                    Content="    Thời khóa biểu"
                    Foreground="White" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Margin="0,5,0,0" Height="44"
                    Click="btnSchedule_Click" Background="#FF263F60" HorizontalAlignment="Left" Width="195"/>


            <Button x:Name="btnScore"
                    Content="    Quản lý điểm" 
                    Foreground="White" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Margin="0,5,0,0"
                    Click="btnScore_Click" Background="#FF263F60" HorizontalAlignment="Left" Height="44" Width="185"/>

            <Button x:Name="btnSalary"
                    Content="    Tài chính cá nhân" 
                    Foreground="White" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Margin="0,5,0,0"
                    Click="btnSalary_Click" Background="#FF263F60" HorizontalAlignment="Left" Height="44" Width="218"/>


        </StackPanel>
        <Button x:Name="btnExit" Grid.Column="0" Grid.Row="1"
                Content="Đăng xuất" Height="60"
                Foreground="#FFCF7A7A" 
                FontSize="15"
                FontWeight="SemiBold"
                BorderThickness="0"
                Click="btnExit_Click" Background="#FF263F60"/>

        <ContentControl x:Name="panelMain"
                        Grid.Column="1"
                        Background="White"/>
    </Grid>
</Window>