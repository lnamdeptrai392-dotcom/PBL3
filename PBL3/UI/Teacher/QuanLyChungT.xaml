<Window x:Class="PBL3a.UI.Teacher.QuanLyChungT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giáo viên - EduCore"
        Width="1000" Height="500"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBCDE0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonActiveStyle" TargetType="Button"
               BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF9A9A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7B1111"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#2C4E62">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Avatar -->
                    <RowDefinition Height="*"/>
                    <!-- Menu -->
                    <RowDefinition Height="Auto"/>
                    <!-- Logout -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Background="#2C4E62" Height="70">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎓" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="EduCore" FontSize="22" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Avatar + Tên giáo viên -->
                <Border Grid.Row="1" Background="#0F2840" Margin="12,10" CornerRadius="10" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="21"
                                Background="#00897B" Margin="0,0,10,0">
                            <TextBlock x:Name="tbAvatarChar" Text="G"
                                       FontSize="18" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="tbUserName" Text="Giáo viên"
                                       Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Giảng viên" Foreground="#7FA8CC" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menu -->
                <StackPanel Grid.Row="2" Margin="0,5,0,5">
                    <TextBlock Text="MENU" Foreground="#4A7FA5" FontSize="10"
                               FontWeight="Bold" Margin="22,8,0,4"/>

                    <Button x:Name="btnInfo"     Content="  👤  Thông tin cá nhân"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="btnInfo_Click"/>
                    <Button x:Name="btnSchedule" Content="  📅  Thời khóa biểu"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="btnSchedule_Click"/>
                    <Button x:Name="btnScore"    Content="  📝  Quản lý điểm"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="btnScore_Click"/>
                    <Button x:Name="btnSalary"   Content="  💵  Tài chính cá nhân"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="btnSalary_Click"/>
                </StackPanel>

                <!-- Đăng xuất -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0"
                        BorderBrush="#1E3A5C" Margin="0,0,0,10">
                    <Button x:Name="btnExit" Content="  🚪  Đăng xuất"
                            Style="{StaticResource LogoutButtonStyle}"
                            Click="btnExit_Click"/>
                </Border>
            </Grid>
        </Border>

        <!-- Nội dung chính -->
        <ContentControl x:Name="panelMain" Grid.Column="1" Background="#F0F2F5"/>
    </Grid>
</Window>