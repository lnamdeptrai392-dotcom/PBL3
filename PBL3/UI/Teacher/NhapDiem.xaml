<UserControl x:Class="PBL3a.UI.Teacher.NhapDiem"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
mc:Ignorable="d"
Background="#F0F2F5" d:DesignWidth="800"  d:DesignHeight="500">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Row -->
            <RowDefinition Height="*"/>
            <!-- DataGrid Card -->
            <RowDefinition Height="Auto"/>
            <!-- Action Button -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="QUẢN LÝ ĐIỂM &amp; NHẬN XÉT" 
                   FontSize="26" FontWeight="Bold" Foreground="#2C3E50"
                   Margin="10,0,0,20"/>

        <!-- FILTER SECTION -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,15">
            <StackPanel Margin="0,0,30,0">
                <TextBlock Text="Mã lớp học" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <ComboBox x:Name="comboBox1" Width="180" Height="35"
                          IsEditable="True"
                          KeyUp="comboBox1_KeyUp"
                          SelectionChanged="comboBox1_SelectedIndexChanged"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Tên lớp" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBox x:Name="textBox1" Width="300" Height="35"
                         IsReadOnly="True" Background="#F5F7FA" 
                         Padding="5,7" BorderBrush="#DCDFE6"/>
            </StackPanel>
        </StackPanel>

        <!-- TABLE CARD -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <DataGrid x:Name="dataGridView1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      RowHeight="35">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã học sinh" Binding="{Binding AccountID}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTen}" Width="1.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Điểm số" Binding="{Binding Diem}" Width="100"/>
                    <DataGridTextColumn Header="Nhận xét của giáo viên" Binding="{Binding NhanXet}" Width="2*"/>
                </DataGrid.Columns>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Foreground" Value="#34495E"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>

        <!-- ACTIONS -->
        <Button x:Name="button2"
                Grid.Row="3"
                Content="Lưu bảng điểm"
                Width="150" Height="40"
                HorizontalAlignment="Right"
                Background="#5D9CB3" Foreground="White"
                FontWeight="SemiBold" Cursor="Hand"
                Click="button2_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>